# --- LLM provider (manager + worker agents) ---
OPENAI_API_KEY=your-openai-key
# Only needed if you switch models to Claude (e.g. MANAGER_MODEL=anthropic/claude-3-5-sonnet-latest)
ANTHROPIC_API_KEY=

# --- Search providers (at least one is required) ---
TAVILY_API_KEY=your-tavily-key
SERPER_API_KEY=your-serper-key
# tavily | serper  (falls back to whichever key is available)
SEARCH_PROVIDER=tavily

# --- Model selection (LiteLLM-style names used by CrewAI) ---
MANAGER_MODEL=gpt-4o
AGENT_MODEL=gpt-4o-mini
